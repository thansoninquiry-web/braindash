# Copy to .env and set the folder BrainDash should scan.
# Windows paths with spaces must be quoted. Forward slashes avoid dotenv
# treating "\r", "\n" or "\t" inside the path as escape sequences.
# Examples: "/Users/you/Obsidian/Brain", "C:/Notes/Brain"
VAULT_PATH="/path/to/your/vault"

# Allow the dashboard to edit, create and delete notes. Off unless set to 1.
# Writes are accepted only from this machine (loopback), never from a phone or
# another PC on the LAN, and replaced/deleted notes are moved to <vault>/.trash.
# BRAINDASH_WRITE=1

# Optional: override the API port (default 5181). Do not use PORT, which many
# shells and CI runners set to 0.
# BRAINDASH_PORT=5181

# Optional: require this token before anything reads the vault. A phone or another
# PC on the LAN gets an unlock screen first, and the browser keeps an HttpOnly
# cookie for a week. Unset means the single-machine install is unchanged.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# BRAINDASH_TOKEN=

# Optional: extra Host names the API answers beside loopback, *.localhost and
# literal addresses. Set this only when you open the dashboard by a DNS name
# (a LAN mDNS name, for example); a bare name allows any port, name:port pins it.
# BRAINDASH_HOSTS=brainbox.local:5181
