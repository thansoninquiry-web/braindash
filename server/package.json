{
  "name": "@braindash/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../scripts/build-server.mjs",
    "start": "tsx src/index.ts",
    "start:built": "node ../scripts/start-built-server.mjs",
    "test": "node ../scripts/run-tests.mjs",
    "test:coverage": "node ../scripts/run-tests.mjs --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
